# Copy to .env.server (git-ignored). Never commit real keys.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Empty = box.ts returns fixtures
BOX_URL=
BOX_SECRET=
# live = booking goes through real Alter; anything else (or empty) = the in-app approval gate
ALTER_MODE=
# Alter app key; required when ALTER_MODE=live
ALTER_API_KEY=
# Alter grant for the founder's Google Calendar; required when ALTER_MODE=live
GOOGLE_GRANT_ID=
# Optional: every invite goes to this address instead of the candidate's
DEMO_INVITE_TO=
# Empty = no tracing
TRACEROOT_TOKEN=
