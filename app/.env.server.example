# Copy to .env.server (git-ignored). Never commit real keys.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Empty = box.ts returns fixtures
BOX_URL=
BOX_SECRET=
# live = booking goes through real Alter; anything else (or empty) = the in-app approval gate
ALTER_MODE=
# Alter app key; required when ALTER_MODE=live
ALTER_API_KEY=
# Alter grant for the founder's Google Calendar; required when ALTER_MODE=live
GOOGLE_GRANT_ID=
# Optional, live mode: second Alter app key with approvals:decide; set = Donna's Approve/Reject is recorded in Alter with this key
ALTER_DECIDER_KEY=
# Required when ALTER_DECIDER_KEY is set: founder's email, sent as the deciding approver; must be an approver on the Alter rule
ALTER_APPROVER_EMAIL=
# Optional: every invite goes to this address instead of the candidate's
DEMO_INVITE_TO=
# TraceRoot tracing (trust lane). Empty key = steps run untraced. TRACEROOT_ENABLED=false turns it off even with a key
TRACEROOT_API_KEY=
# Optional: URL of a self-hosted TraceRoot
TRACEROOT_HOST_URL=
# Optional: dashboard URL of the TraceRoot project; shown as the trace link on a candidate
TRACEROOT_PROJECT_URL=
